<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Super Chef: Esteira Maluca</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="hud-bar">
        <div class="hud-group">
            <div class="hud-pill" title="Pedidos Entregues">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span id="score-val">0</span>
            </div>
            <div class="hud-pill level-badge" title="Nível Procedural">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0284C7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
                <span>Nv. <strong id="level-val">1</strong></span>
            </div>
        </div>

        <button type="button" class="btn-exit" onclick="exitArcadeGame()" title="Concluir">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Concluir
        </button>
    </div>

    <canvas id="game-canvas"></canvas>

    <div id="end-overlay" class="end-overlay">
        <div class="end-card">
            <div class="trophy-icon">
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h2>Cozinha Fechada!</h2>
            <p>Lanches preparados: <strong id="final-score">0</strong></p>
            <button type="button" class="btn-finish" onclick="exitArcadeGame()">Voltar para Atividades</button>
        </div>
    </div>

    <script src="game.js"></script>
</body>
</html>
